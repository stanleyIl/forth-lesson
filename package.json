{
  "name": "campusclaw-mygroup",
  "version": "1.0.0",
  "description": "为教师和学生提供一个按班级隔离的教学材料管理系统。",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:backfill-embeddings": "tsx src/retrieval/backfill.ts",
    "db:backfill-chunks": "tsx src/knowledge/backfill.ts",
    "mcp:start": "node dist/mcp/server.js",
    "report:lesson6": ".venv/bin/python scripts/generate-lesson6-report.py",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "overrides": {
    "source-map-js": "1.2.2"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.13.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.1",
    "pg-mem": "^3.0.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ajv": "^8.20.0",
    "fastify": "^5.12.7",
    "jose": "^6.2.12",
    "marked": "^18.0.14",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "sanitize-html": "^2.18.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
