# Copy this file to .env and replace the placeholder with a private value.
# SESSION_SECRET must contain at least 32 characters.
SESSION_SECRET=replace-with-a-private-random-value
JWT_SECRET=replace-with-another-private-random-value
JWT_ISSUER=campusclaw
JWT_AUDIENCE=campusclaw-browser
JWT_TTL_SECONDS=3600

POSTGRES_PASSWORD=campusclaw-local
APP_PORT=3000
SESSION_TTL_SECONDS=86400
SESSION_COOKIE_NAME=campusclaw_session
HTTPS_ENABLED=false
UPLOAD_MAX_BYTES=1048576
EMBEDDING_ENDPOINT=http://host.docker.internal:11434/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_MS=5000
EMBEDDING_BATCH_SIZE=32
SEARCH_MAX_QUERY_LENGTH=1000
SEARCH_DEFAULT_LIMIT=10
SEARCH_MAX_LIMIT=50
SEARCH_LEXICAL_CANDIDATES=50
SEARCH_VECTOR_CANDIDATES=50
SEARCH_EXCERPT_LENGTH=240
SEARCH_RRF_K=60
CHAT_ENDPOINT=http://host.docker.internal:18081/v1/chat/completions
CHAT_API_KEY=
CHAT_MODEL=campusclaw-chat
CHAT_TIMEOUT_MS=30000
CHAT_MAX_TOKENS=600
ASK_MAX_QUESTION_LENGTH=2000
CONVERSATION_HISTORY_MESSAGES=12
CONVERSATION_HISTORY_CHARS=12000
CHUNK_MAX_CHARS=800
CHUNK_OVERLAP_CHARS=80
VECTOR_SIMILARITY_THRESHOLD=0.35
AI_APPLICATION_MAX_PER_CLASS=20
PROMPT_TEMPLATE_MAX_PER_CLASS=50
SKILL_MAX_PER_CLASS=50
SKILL_UPLOAD_MAX_BYTES=131072
SKILL_STORAGE_ROOT=/var/lib/campusclaw/skills
MCP_SERVER_NAME=campus-tools
MCP_SERVER_URL=http://mcp-server:3100/mcp
MCP_CONNECT_TIMEOUT_MS=5000
MCP_CALL_TIMEOUT_MS=10000
TOOL_MAX_ROUNDS=1
TOOL_MAX_CALLS=2
TOOL_MAX_OUTPUT_CHARS=8000
EXECUTION_TRACE_RETENTION_DAYS=30
EXECUTION_TRACE_MAX_PER_CLASS=500
EXECUTION_TRACE_PREVIEW_CHARS=2000

# Required only when running the administrative seed command.
SEED_TEACHER_PASSWORD=replace-with-a-teacher-password
SEED_STUDENT_PASSWORD=replace-with-a-student-password
